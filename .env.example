# ==========================================
# PostgreSQL Database Configuration
# ==========================================
POSTGRES_USER=postgres # PostgreSQL database superuser username
POSTGRES_PASSWORD=postgres # PostgreSQL database superuser password
POSTGRES_DB=rise_dev # PostgreSQL database name
POSTGRES_PORT=5432 # PostgreSQL host port
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rise_dev # Primary PostgreSQL connection URL

# ==========================================
# Redis Cache & Task Queue Configuration
# ==========================================
REDIS_HOST=localhost # Redis server hostname
REDIS_PORT=6379 # Redis server port
REDIS_URL=redis://localhost:6379/0 # Redis connection URL for caching, locks, and task queue broker

# ==========================================
# Qdrant Vector Database Configuration
# ==========================================
QDRANT_HOST=localhost # Qdrant server hostname
QDRANT_PORT=6333 # Qdrant REST API port
QDRANT_GRPC_PORT=6334 # Qdrant gRPC API port
QDRANT_URL=http://localhost:6333 # Qdrant vector database REST endpoint URL
QDRANT_API_KEY=your_qdrant_api_key_here # Qdrant authentication API key (optional for local dev)

# ==========================================
# AI / LLM Provider Credentials & Endpoint Configuration
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here # Google Gemini API key for primary reasoning and RCA tasks
OPENAI_API_KEY=your_openai_api_key_here # OpenAI API key for fallback reasoning and summarization
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here # AWS Access Key ID for Amazon Bedrock LLM access
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here # AWS Secret Access Key for Amazon Bedrock LLM access
AWS_REGION=us-east-1 # AWS region where Bedrock service is hosted
OLLAMA_BASE_URL=http://localhost:11434 # Base URL for self-hosted Ollama local LLM inference

# ==========================================
# GitHub Integration Credentials
# ==========================================
GITHUB_APP_ID=123456 # GitHub App numeric application ID
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n..." # GitHub App private key for installation authentication
GITHUB_CLIENT_ID=your_github_client_id_here # GitHub OAuth Client ID
GITHUB_CLIENT_SECRET=your_github_client_secret_here # GitHub OAuth Client Secret
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here # Secret token for validating incoming GitHub webhook signatures
GITHUB_TOKEN=your_github_personal_access_token_here # Personal access token for fallback GitHub API access

# ==========================================
# Slack Integration Credentials
# ==========================================
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token # Slack Bot User OAuth token for sending messages and ChatOps
SLACK_SIGNING_SECRET=your_slack_signing_secret_here # Secret for validating incoming Slack event webhook signatures
SLACK_APP_TOKEN=xapp-your-slack-app-token # Slack App-level token for Socket Mode connections

# ==========================================
# Observability & Tracing Configuration (Langfuse)
# ==========================================
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key-here # Langfuse public key for LLM observability tracing
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key-here # Langfuse secret key for LLM observability tracing
LANGFUSE_HOST=http://localhost:3000 # Langfuse instance host URL for LLM tracing and evaluation

# ==========================================
# Supabase Auth Configuration
# ==========================================
SUPABASE_URL=https://your-project-ref.supabase.co           # Supabase project URL
SUPABASE_ANON_KEY=your_supabase_anon_key_here               # Supabase anonymous/public API key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key    # Supabase service-role key (server-side only, never expose to clients)
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here           # HS256 secret from Supabase → Settings → API → JWT Secret (used by auth-service middleware to verify Bearer tokens)
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json  # RS256 JWKS endpoint (reserved — RS256 verification NOT yet implemented)

# ==========================================
# Deployment Environment
# ==========================================
ENVIRONMENT=local   # Deployment environment name.  Valid values: local, development, dev, ci, test, staging, production, prod.
                    # The auth-service startup guard reads this to constrain RISE_TEST_MODE usage (see below).

# ==========================================
# ⚠ SECURITY — DO NOT COPY TO STAGING/PROD
# ==========================================
# RISE_TEST_MODE=1 disables ALL Supabase JWT signature verification.
# It exists only for local unit tests.  The main.py startup guard
# (_assert_safe_test_mode) raises RuntimeError and refuses to start if
# RISE_TEST_MODE=1 and ENVIRONMENT is not in {local, dev, development, ci, test}.
# NEVER set this in a .env file that is copied to staging or production.
# RISE_TEST_MODE=0   # DEFAULT — leave commented out or set to 0 always
