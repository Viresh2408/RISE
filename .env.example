# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rise_dev # PostgreSQL DB connection URL

# Cache & Task Queue
REDIS_URL=redis://localhost:6379/0 # Redis connection URL for caching & Celery queue

# Vector Database
QDRANT_URL=http://localhost:6333 # Qdrant vector database URL

# AI / LLM Provider Keys
GEMINI_API_KEY=your_gemini_api_key_here # Google Gemini API key
OPENAI_API_KEY=your_openai_api_key_here # OpenAI API key fallback

# Integrations
GITHUB_TOKEN=your_github_token_here # GitHub App or personal access token
SLACK_BOT_TOKEN=your_slack_bot_token_here # Slack Bot token for ChatOps
